graph TB
    subgraph Input["📥 INPUT LAYER"]
        A1["🎙️ Google Meet\nRecording (.webm)"]
        A2["📁 DOCX\nTranscript File"]
        A3["🎵 Audio Files\n(mp3/mp4/m4a/flac)"]
    end

    subgraph Ext["🧩 PLANNED: Browser Extension"]
        B1["Audio Capture"]
        B2["Upload to Server"]
    end

    subgraph API["🌐 PLANNED: FastAPI Endpoints"]
        C1["POST /upload"]
        C2["GET /transcripts"]
        C3["POST /analyze"]
        C4["POST /chat"]
    end

    subgraph NLP["📝 NLP LAYER"]
        D1["PersianNormalizer\napp/nlp/normalizer.py"]
        D2["Arabic → Persian\nZWNJ Insertion\nWhitespace Cleanup"]
    end

    subgraph Services["⚙️ SERVICES LAYER"]
        direction TB
        E1["MeetingIntelligenceService\napp/services/meeting_intelligence.py"]
        E2["SimpleVectorDB\napp/services/vector_db.py"]
        E3["RAGChatService\napp/services/rag_chat.py"]
    end

    subgraph LLM["🤖 LLM LAYER (Ollama)"]
        direction TB
        F1["Whisper large-v3\nSpeech-to-Text\n(main.py)"]
        F2["DeepSeek-r1:8b\nText Correction\n(main.py)"]
        F3["Qwen2.5:7b\nMeeting Analysis\n(app/)"]
        F4["Qwen2.5:7b\nEmbeddings\n(app/)"]
    end

    subgraph Storage["💾 STORAGE LAYER"]
        direction TB
        G1["uploads/\n{company_id}/"]
        G2["transcripts/\n{company_id}/"]
        G3["users.json\nAuthentication"]
        G4["vector_store.json\nVector Embeddings"]
        G5["ChromaDB\n(main.py)"]
    end

    subgraph Output["📊 OUTPUT LAYER"]
        H1["MeetingSummary\nsummary + key_points"]
        H2["ActionItems\ntask + assignee + priority"]
        H3["Decisions\ndecision + context"]
        H4["StrategicInsights\nrisks + opportunities"]
        H5["DOCX Reports"]
        H6["RAG Q&A with Citations"]
    end

    subgraph Models["📋 DATA MODELS (Pydantic)"]
        I1["TranscriptSegment\nspeaker + time + text"]
        I2["Transcript\nmeeting_id + segments"]
        I3["ActionItem\ntask + assignee + deadline"]
        I4["Decision\ndecision + context"]
        I5["MeetingSummary\nsummary + decisions + actions"]
        I6["StrategicInsights\nrisks + opportunities + recs"]
    end

    %% Input → Extension
    A1 --> B1
    B1 --> B2
    B2 --> C1

    %% Input → Legacy
    A1 --> F1
    A3 --> F1
    F1 --> F2
    F2 --> D1

    %% Input → Modular
    A2 --> D1
    D1 --> D2

    %% D2 → Services
    D2 --> E1
    D2 --> E2

    %% Services ↔ LLM
    E1 --> F3
    E2 --> F4
    E3 --> F3

    %% Services → Storage
    E2 --> G4
    E1 --> G2
    E1 --> G5

    %% Services → Output
    E1 --> H1
    E1 --> H2
    E1 --> H3
    E1 --> H4
    E2 --> H6
    E3 --> H6

    %% Storage connections
    G1 --> G2
    G3 -.-> C1

    %% Models
    I2 --> E1
    I5 --> H1
    I6 --> H4

    %% API (planned)
    C1 --> G1
    C2 --> G2
    C3 --> E1
    C4 --> E3

    %% Styling
    classDef input fill:#4CAF50,color:#fff,stroke:#333
    classDef ext fill:#9C27B0,color:#fff,stroke:#333
    classDef api fill:#2196F3,color:#fff,stroke:#333
    classDef nlp fill:#FF9800,color:#fff,stroke:#333
    classDef service fill:#F44336,color:#fff,stroke:#333
    classDef llm fill:#00BCD4,color:#fff,stroke:#333
    classDef storage fill:#795548,color:#fff,stroke:#333
    classDef output fill:#607D8B,color:#fff,stroke:#333
    classDef model fill:#3F51B5,color:#fff,stroke:#333

    class A1,A2,A3 input
    class B1,B2 ext
    class C1,C2,C3,C4 api
    class D1,D2 nlp
    class E1,E2,E3 service
    class F1,F2,F3,F4 llm
    class G1,G2,G3,G4,G5 storage
    class H1,H2,H3,H4,H5,H6 output
    class I1,I2,I3,I4,I5,I6 model
